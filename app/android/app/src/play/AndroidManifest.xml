<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Google Play buraxılışı üçün istisnalar (bax build.gradle.kts şərhi):
         - Arxa fon məkan icazəsi silinir (V1-də xüsusi baxış tələb etməmək üçün).
         - App-daxili APK yeniləməsi silinir (Play öz mexanizmini tələb edir). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove"/>

    <application
        android:usesCleartextTraffic="false"
        tools:replace="android:usesCleartextTraffic">
        <!-- main.dart bunu native kanaldan (dildostu/build_flavor) oxuyur ki,
             self-update/arxa-fon-məkan UI-larını göstərməsin. -->
        <meta-data android:name="dildostu.isPlayBuild" android:value="true"/>
    </application>
</manifest>
