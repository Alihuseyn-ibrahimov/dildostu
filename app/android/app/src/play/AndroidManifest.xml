<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Google Play buraxılışı üçün istisnalar (bax build.gradle.kts şərhi):
         - Arxa fon məkan icazəsi silinir (V1-də xüsusi baxış tələb etməmək üçün).
         - App-daxili APK yeniləməsi silinir (Play öz mexanizmini tələb edir). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove"/>

    <!-- Play-in "məhdud icazə" siyahısındadır: batareya optimallaşdırmasından
         çıxma yalnız dar istisnalarda qəbul edilir. Arxa fon rutin toplama
         Play buraxılışında onsuz da yoxdur, ona görə icazə də lazımsızdır. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove"/>

    <!-- Play "Exact Alarm" siyasəti bu icazəni yalnız zəngli saat/təqvim
         tipli tətbiqlərə verir. Kod 2026-08-10-dan `inexactAllowWhileIdle`
         işlədir (bax notification_service.dart) — icazə artıq lazım deyil. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove"/>

    <application
        android:usesCleartextTraffic="false"
        tools:replace="android:usesCleartextTraffic">
        <!-- main.dart bunu native kanaldan (dildostu/build_flavor) oxuyur ki,
             self-update/arxa-fon-məkan UI-larını göstərməsin. -->
        <meta-data android:name="dildostu.isPlayBuild" android:value="true"/>
    </application>
</manifest>
