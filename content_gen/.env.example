# DilDostu məzmun generatoru üçün API açarları.
# Bu faylı .env adı ilə kopyalayın və BİR açar doldurun.
# Keyfiyyət sırası: Anthropic (Claude) > Groq 70b > OpenAI.

# Tövsiyə — Azərbaycanca üçün ən yüksək keyfiyyət:
ANTHROPIC_API_KEY=

# Alternativ (pulsuz, amma günlük token limiti var):
GROQ_API_KEY=

# Alternativ:
OPENAI_API_KEY=

# İstəyə görə override:
# GEN_PROVIDER=anthropic   # anthropic | groq | openai
# GEN_MODEL=claude-sonnet-5
