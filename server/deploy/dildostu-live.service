[Unit]
Description=DilDostu Live FastAPI backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/quantum/dildostu/server
EnvironmentFile=/opt/quantum/dildostu/server/.env
# 2 uvicorn worker; yalnız localhost-a bağlanır, nginx qarşıda HTTPS verir.
ExecStart=/opt/quantum/dildostu/server/.venv/bin/gunicorn \
    dildostu_server.app:app \
    -k uvicorn.workers.UvicornWorker \
    -w 2 \
    -b 127.0.0.1:8100
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
