[Unit]
Description=DilDostu Live FastAPI backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/dildostu/server
EnvironmentFile=/opt/dildostu/server/.env
# 512MB droplet: 1 worker. Yalnız localhost-a bağlanır, nginx qarşıda HTTPS.
ExecStart=/opt/dildostu/server/.venv/bin/gunicorn \
    dildostu_server.app:app \
    -k uvicorn.workers.UvicornWorker \
    -w 1 \
    -b 127.0.0.1:8100
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
