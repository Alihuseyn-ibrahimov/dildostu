# DilDostu Live server — API açarları
# Groq: MasterNR1-dan AYRI açar tövsiyə (gündəlik limit paylaşılmasın)
GROQ_API_KEY=
# İstəyə görə — personal mode-lar (sadələşdir/çətinləşdir) canlı işləsin:
ANTHROPIC_API_KEY=
# Məkan tanıma (Foursquare Places API — pulsuz service key). Bu olmadan
# /place/resolve 503 verir, app OSM ehtiyatına düşür (AZ örtüyü zəif).
FOURSQUARE_API_KEY=

# İstifadəçi giriş tokenlərinin imzalanması (MƏCBURİ, ən azı 32 simvol).
# Yaratmaq üçün:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# DİQQƏT: bunu dəyişsən bütün istifadəçilər sistemdən çıxarılır.
JWT_SECRET=

# İstəyə görə model override:
# GROQ_MODEL=llama-3.3-70b-versatile
# CLAUDE_MODEL=claude-sonnet-5
